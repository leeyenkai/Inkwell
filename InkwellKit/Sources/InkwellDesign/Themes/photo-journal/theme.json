{
  "id": "photo-journal",
  "name": "Photo journal",
  "summary": "Dark and wide, with a grid of pictures on the home page and full-width photos in posts.",
  "tokens": [
    {
      "name": "--bg",
      "label": "Background",
      "kind": "color",
      "group": "Colours",
      "light": "#F6F5F2",
      "dark": "#0E0F10"
    },
    {
      "name": "--surface",
      "label": "Panels",
      "kind": "color",
      "group": "Colours",
      "light": "#FFFFFF",
      "dark": "#18191B"
    },
    {
      "name": "--text",
      "label": "Text",
      "kind": "color",
      "group": "Colours",
      "light": "#161616",
      "dark": "#EDEBE7"
    },
    {
      "name": "--muted",
      "label": "Secondary text",
      "kind": "color",
      "group": "Colours",
      "light": "#5C5B57",
      "dark": "#A6A39D"
    },
    {
      "name": "--accent",
      "label": "Accent",
      "kind": "color",
      "group": "Colours",
      "light": "#A8502A",
      "dark": "#E9A464"
    },
    {
      "name": "--border",
      "label": "Lines",
      "kind": "color",
      "group": "Colours",
      "light": "#E2E0DA",
      "dark": "#2A2C2F"
    },
    {
      "name": "--font-body",
      "label": "Body font",
      "kind": "font",
      "group": "Fonts",
      "light": "Avenir, \"Avenir Next\", Montserrat, \"Segoe UI\", sans-serif"
    },
    {
      "name": "--font-heading",
      "label": "Heading font",
      "kind": "font",
      "group": "Fonts",
      "light": "Avenir, \"Avenir Next\", Montserrat, \"Segoe UI\", sans-serif"
    },
    {
      "name": "--font-mono",
      "label": "Code font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-size",
      "label": "Text size",
      "kind": "length",
      "group": "Fonts",
      "light": "18px"
    },
    {
      "name": "--line-height",
      "label": "Line spacing",
      "kind": "number",
      "group": "Fonts",
      "light": "1.65"
    },
    {
      "name": "--width",
      "label": "Content width",
      "kind": "length",
      "group": "Layout",
      "light": "40rem"
    },
    {
      "name": "--radius",
      "label": "Corner rounding",
      "kind": "length",
      "group": "Layout",
      "light": "2px"
    }
  ],
  "options": [
    {
      "key": "home_style",
      "label": "Home page list",
      "kind": "choice",
      "values": [
        "grid",
        "cards",
        "list",
        "chain"
      ]
    },
    {
      "key": "date_format",
      "label": "Date format",
      "kind": "choice",
      "values": [
        "%B %-d, %Y",
        "%b %-d, %Y",
        "%-d %B %Y",
        "%Y-%m-%d"
      ]
    },
    {
      "key": "reading_time",
      "label": "Show reading time",
      "kind": "bool"
    },
    {
      "key": "appearance",
      "label": "Appearance",
      "kind": "choice",
      "values": [
        "auto",
        "light",
        "dark"
      ]
    }
  ],
  "defaults": {
    "home_style": "grid",
    "date_format": "%-d %B %Y",
    "reading_time": false,
    "appearance": "dark"
  }
