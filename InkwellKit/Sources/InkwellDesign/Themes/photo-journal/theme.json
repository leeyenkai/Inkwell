{
  "id": "photo-journal",
  "name": "Photo journal",
  "summary": "A wide layout where pictures lead and posts show as cards.",
  "tokens": [
    {
      "name": "--bg",
      "label": "Background",
      "kind": "color",
      "group": "Colours",
      "light": "#F7F7F5",
      "dark": "#111113"
    },
    {
      "name": "--surface",
      "label": "Panels",
      "kind": "color",
      "group": "Colours",
      "light": "#FFFFFF",
      "dark": "#1B1B1E"
    },
    {
      "name": "--text",
      "label": "Text",
      "kind": "color",
      "group": "Colours",
      "light": "#18181A",
      "dark": "#EDEDED"
    },
    {
      "name": "--muted",
      "label": "Secondary text",
      "kind": "color",
      "group": "Colours",
      "light": "#6E6E73",
      "dark": "#9C9CA1"
    },
    {
      "name": "--accent",
      "label": "Accent",
      "kind": "color",
      "group": "Colours",
      "light": "#E0583A",
      "dark": "#FF7A57"
    },
    {
      "name": "--border",
      "label": "Lines",
      "kind": "color",
      "group": "Colours",
      "light": "#E4E4E1",
      "dark": "#2A2A2E"
    },
    {
      "name": "--font-body",
      "label": "Body font",
      "kind": "font",
      "group": "Fonts",
      "light": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif"
    },
    {
      "name": "--font-heading",
      "label": "Heading font",
      "kind": "font",
      "group": "Fonts",
      "light": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif"
    },
    {
      "name": "--font-mono",
      "label": "Code font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-size",
      "label": "Text size",
      "kind": "length",
      "group": "Fonts",
      "light": "17px"
    },
    {
      "name": "--line-height",
      "label": "Line spacing",
      "kind": "number",
      "group": "Fonts",
      "light": "1.6"
    },
    {
      "name": "--width",
      "label": "Content width",
      "kind": "length",
      "group": "Layout",
      "light": "62rem"
    },
    {
      "name": "--radius",
      "label": "Corner rounding",
      "kind": "length",
      "group": "Layout",
      "light": "10px"
    }
  ],
  "options": [
    {
      "key": "home_style",
      "label": "Home page list",
      "kind": "choice",
      "values": [
        "list",
        "cards",
        "chain"
      ]
    },
    {
      "key": "date_format",
      "label": "Date format",
      "kind": "choice",
      "values": [
        "%B %-d, %Y",
        "%b %-d, %Y",
        "%-d %B %Y",
        "%Y-%m-%d"
      ]
    },
    {
      "key": "reading_time",
      "label": "Show reading time",
      "kind": "bool"
    },
    {
      "key": "appearance",
      "label": "Appearance",
      "kind": "choice",
      "values": [
        "auto",
        "light",
        "dark"
      ]
    }
  ],
  "defaults": {
    "home_style": "cards",
    "date_format": "%-d %B %Y",
    "reading_time": false,
    "appearance": "auto"
  }
}