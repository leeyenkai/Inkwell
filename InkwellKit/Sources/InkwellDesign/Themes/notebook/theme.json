{
  "id": "notebook",
  "name": "Notebook",
  "summary": "A sidebar with your title and menu beside the page, and a compact dated list of posts.",
  "tokens": [
    {
      "name": "--bg",
      "label": "Background",
      "kind": "color",
      "group": "Colours",
      "light": "#FFFFFF",
      "dark": "#16181D"
    },
    {
      "name": "--surface",
      "label": "Panels",
      "kind": "color",
      "group": "Colours",
      "light": "#F4F5F7",
      "dark": "#1D2026"
    },
    {
      "name": "--text",
      "label": "Text",
      "kind": "color",
      "group": "Colours",
      "light": "#1B1E24",
      "dark": "#E6E8EC"
    },
    {
      "name": "--muted",
      "label": "Secondary text",
      "kind": "color",
      "group": "Colours",
      "light": "#5D6470",
      "dark": "#9CA3AF"
    },
    {
      "name": "--accent",
      "label": "Accent",
      "kind": "color",
      "group": "Colours",
      "light": "#2F5FD0",
      "dark": "#86A8FF"
    },
    {
      "name": "--border",
      "label": "Lines",
      "kind": "color",
      "group": "Colours",
      "light": "#E3E6EB",
      "dark": "#2C3039"
    },
    {
      "name": "--font-body",
      "label": "Body font",
      "kind": "font",
      "group": "Fonts",
      "light": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif"
    },
    {
      "name": "--font-heading",
      "label": "Heading font",
      "kind": "font",
      "group": "Fonts",
      "light": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif"
    },
    {
      "name": "--font-mono",
      "label": "Code font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-size",
      "label": "Text size",
      "kind": "length",
      "group": "Fonts",
      "light": "17px"
    },
    {
      "name": "--line-height",
      "label": "Line spacing",
      "kind": "number",
      "group": "Fonts",
      "light": "1.6"
    },
    {
      "name": "--width",
      "label": "Content width",
      "kind": "length",
      "group": "Layout",
      "light": "44rem"
    },
    {
      "name": "--radius",
      "label": "Corner rounding",
      "kind": "length",
      "group": "Layout",
      "light": "8px"
    }
  ],
  "options": [
    {
      "key": "home_style",
      "label": "Home page list",
      "kind": "choice",
      "values": [
        "list",
        "cards",
        "chain"
      ]
    },
    {
      "key": "date_format",
      "label": "Date format",
      "kind": "choice",
      "values": [
        "%B %-d, %Y",
        "%b %-d, %Y",
        "%-d %B %Y",
        "%Y-%m-%d"
      ]
    },
    {
      "key": "reading_time",
      "label": "Show reading time",
      "kind": "bool"
    },
    {
      "key": "appearance",
      "label": "Appearance",
      "kind": "choice",
      "values": [
        "auto",
        "light",
        "dark"
      ]
    }
  ],
  "defaults": {
    "home_style": "list",
    "date_format": "%-d %B %Y",
    "reading_time": false,
    "appearance": "auto"
  }
}
