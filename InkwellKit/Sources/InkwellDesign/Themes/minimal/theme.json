{
  "id": "minimal",
  "name": "Minimal",
  "summary": "Plain monospaced text with lots of space, dates in the margin and almost nothing else.",
  "tokens": [
    {
      "name": "--bg",
      "label": "Background",
      "kind": "color",
      "group": "Colours",
      "light": "#FFFFFF",
      "dark": "#111111"
    },
    {
      "name": "--surface",
      "label": "Panels",
      "kind": "color",
      "group": "Colours",
      "light": "#F5F5F5",
      "dark": "#1A1A1A"
    },
    {
      "name": "--text",
      "label": "Text",
      "kind": "color",
      "group": "Colours",
      "light": "#111111",
      "dark": "#E6E6E6"
    },
    {
      "name": "--muted",
      "label": "Secondary text",
      "kind": "color",
      "group": "Colours",
      "light": "#5F5F5F",
      "dark": "#9B9B9B"
    },
    {
      "name": "--accent",
      "label": "Accent",
      "kind": "color",
      "group": "Colours",
      "light": "#1A4FD6",
      "dark": "#8AB0FF"
    },
    {
      "name": "--border",
      "label": "Lines",
      "kind": "color",
      "group": "Colours",
      "light": "#E2E2E2",
      "dark": "#2B2B2B"
