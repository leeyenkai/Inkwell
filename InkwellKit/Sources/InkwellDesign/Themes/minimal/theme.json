    },
    {
      "name": "--font-heading",
      "label": "Heading font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-mono",
      "label": "Code font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-size",
      "label": "Text size",
      "kind": "length",
      "group": "Fonts",
      "light": "15px"
    },
    {
      "name": "--line-height",
      "label": "Line spacing",
      "kind": "number",
      "group": "Fonts",
      "light": "1.75"
    },
    {
      "name": "--width",
      "label": "Content width",
      "kind": "length",
      "group": "Layout",
      "light": "40rem"
    },
    {
      "name": "--radius",
      "label": "Corner rounding",
      "kind": "length",
      "group": "Layout",
      "light": "0px"
    }
