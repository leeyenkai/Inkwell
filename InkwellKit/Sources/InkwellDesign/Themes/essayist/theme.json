{
  "id": "essayist",
  "name": "Essayist",
  "summary": "A centred serif column on warm paper, with a drop cap and small capitals. For long essays.",
  "tokens": [
    {
      "name": "--bg",
      "label": "Background",
      "kind": "color",
      "group": "Colours",
      "light": "#FBF8F3",
      "dark": "#1B1916"
    },
    {
      "name": "--surface",
      "label": "Panels",
      "kind": "color",
      "group": "Colours",
      "light": "#F3EDE3",
      "dark": "#25221E"
    },
    {
      "name": "--text",
      "label": "Text",
      "kind": "color",
      "group": "Colours",
      "light": "#1F1D1A",
      "dark": "#ECE6DC"
    },
    {
      "name": "--muted",
      "label": "Secondary text",
      "kind": "color",
      "group": "Colours",
      "light": "#675F55",
      "dark": "#A99F91"
    },
    {
      "name": "--accent",
      "label": "Accent",
      "kind": "color",
      "group": "Colours",
      "light": "#9C3F26",
      "dark": "#E8916B"
    },
    {
      "name": "--border",
      "label": "Lines",
      "kind": "color",
      "group": "Colours",
      "light": "#E5DDCF",
      "dark": "#38332C"
    },
    {
      "name": "--font-body",
      "label": "Body font",
      "kind": "font",
      "group": "Fonts",
      "light": "Charter, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif"
    },
    {
      "name": "--font-heading",
      "label": "Heading font",
      "kind": "font",
      "group": "Fonts",
      "light": "Charter, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif"
    },
    {
      "name": "--font-mono",
      "label": "Code font",
      "kind": "font",
      "group": "Fonts",
      "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    {
      "name": "--font-size",
      "label": "Text size",
      "kind": "length",
      "group": "Fonts",
      "light": "20px"
    },
    {
      "name": "--line-height",
      "label": "Line spacing",
      "kind": "number",
      "group": "Fonts",
      "light": "1.65"
    },
    {
      "name": "--width",
      "label": "Content width",
      "kind": "length",
      "group": "Layout",
      "light": "37rem"
    },
    {
      "name": "--radius",
      "label": "Corner rounding",
      "kind": "length",
      "group": "Layout",
      "light": "3px"
    }
  ],
  "options": [
    {
      "key": "home_style",
      "label": "Home page list",
      "kind": "choice",
      "values": [
        "list",
        "cards",
        "chain"
      ]
    },
    {
      "key": "date_format",
      "label": "Date format",
      "kind": "choice",
      "values": [
        "%B %-d, %Y",
        "%b %-d, %Y",
        "%-d %B %Y",
        "%Y-%m-%d"
      ]
    },
    {
      "key": "reading_time",
      "label": "Show reading time",
      "kind": "bool"
    },
    {
      "key": "appearance",
      "label": "Appearance",
      "kind": "choice",
      "values": [
        "auto",
        "light",
        "dark"
      ]
    }
  ],
  "defaults": {
    "home_style": "list",
    "date_format": "%B %-d, %Y",
    "reading_time": true,
    "appearance": "auto"
  }
}
